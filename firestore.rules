rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // LOTUS CEYLON - FIRESTORE SECURITY RULES
    // =========================================================================
    // Public Catalog: Anyone can read packages, categories and destinations.
    // Writes are restricted strictly to authenticated admin users.
    // =========================================================================
    
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Inquiries: Guests can submit inquiries freely; only admins can view or modify.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Reviews & Testimonials: Publicly readable; admin moderated.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin & system collection fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
