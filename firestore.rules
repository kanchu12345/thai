rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // LOTUS CEYLON - FIRESTORE SECURITY RULES
    // =========================================================================
    
    function isAdmin() {
      return request.auth != null;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quick Inquiries: Public can create; admin only read, update, delete
    match /inquiries_quick/{inquiryId} {
      allow create: if request.resource.data.hp_website_lotus == null || request.resource.data.hp_website_lotus == '';
      allow read, update, delete: if isAdmin();
    }

    // Detailed Inquiries: Public can create; admin only read, update, delete
    match /inquiries_detailed/{inquiryId} {
      allow create: if request.resource.data.hp_website_lotus == null || request.resource.data.hp_website_lotus == '';
      allow read, update, delete: if isAdmin();
    }

    // Legacy Inquiries (kept for backward compatibility)
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Team & Representatives: Public read; admin write
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews & Testimonials: Publicly readable; admin moderated
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin & system collection fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
