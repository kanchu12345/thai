rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    

    // =========================================================================

    // LOTUS CEYLON - PRODUCTION FIRESTORE SECURITY RULES

    // Allows public read of published catalog data so the website & admin

    // never get permission errors on collection queries.

    // Restricts ALL write/update/delete operations to authenticated admins.

    // =========================================================================



    function isAuthenticated() {

      return request.auth != null;

    }



    function isAdmin() {

      return isAuthenticated() && (

        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||

        request.auth.token.admin == true

      );

    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.admin == true
      );
    }



    // 1. Public Content Collections (Read-only for public site, Write for verified Admin)

    match /settings/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /navigation/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /pages/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /cms_pages/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /destinations/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /categories/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /tours/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /packages/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /posts/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /testimonials/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /reviews/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /team/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /faqs/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /formDefinitions/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    match /redirects/{docId} {

      allow read: if true;

      allow write: if isAdmin();

    }



    // 2. Inquiries: Public create-only with honeypot; Admin read/update/delete

    match /inquiries/{docId} {

      allow create: if request.resource.data.hp_website_lotus == null || request.resource.data.hp_website_lotus == '';

      allow read, update, delete: if isAdmin();

    }

    match /inquiries_quick/{docId} {

      allow create: if request.resource.data.hp_website_lotus == null || request.resource.data.hp_website_lotus == '';

      allow read, update, delete: if isAdmin();

    }

    match /inquiries_detailed/{docId} {

      allow create: if request.resource.data.hp_website_lotus == null || request.resource.data.hp_website_lotus == '';

      allow read, update, delete: if isAdmin();

    }



    // 3. Admin & Audit Collections: Authenticated Admins only

    match /activityLog/{docId} {

      allow read, write: if isAdmin();

    }

    match /admins/{docId} {

      allow read: if isAuthenticated();

      allow write: if isSuperAdmin();

    }



    // 4. Default Fallback: Closed by default

    match /{document=**} {

      allow read: if false;

      allow write: if false;

    }

  }

}

