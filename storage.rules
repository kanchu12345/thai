rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Strict Admin check: authenticated user with document in 'admins' collection or admin claim
    function isAdmin() {
      return request.auth != null && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }

    // Public read for media; Admin write with validation (images only, max 5MB)
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /lotus/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
